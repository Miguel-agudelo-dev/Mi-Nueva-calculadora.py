import tkinter as tk

ventana = tk.Tk()
ventana.title("Mi Calculadora")
ventana.geometry("300x400")

pantalla = tk.Entry(ventana, font=("Arial", 20), width=15, justify="right")
pantalla.grid(row=0, column=0, columnspan=4, padx=10, pady=15)

def clic_boton(valor):
    if valor == "C":
        pantalla.delete(0, tk.END)
    elif valor == "=":
        try:
            resultado = eval(pantalla.get())
            pantalla.delete(0, tk.END)
            pantalla.insert(0, str(resultado))
        except:
            pantalla.delete(0, tk.END)
            pantalla.insert(0, "Error")
    else:
        pantalla.insert(tk.END, valor)

botones = [
    "7", "8", "9", "/",
    "4", "5", "6", "*",
    "1", "2", "3", "-",
    "C", "0", "=", "+"
]

fila = 1
columna = 0

for texto in botones:
    boton = tk.Button(ventana, text=texto, font=("Arial", 14), width=2, height=1, command=lambda t=texto: clic_boton(t))
    boton.grid(row=fila, column=columna, padx=4, pady=4)
    columna += 1
    if columna > 3:
        columna = 0
        fila += 1

ventana.mainloop()
